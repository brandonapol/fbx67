{
  "name": "second-rush-text",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "play": "node src/cli.ts",
    "explore": "node --max-old-space-size=1536 src/explore.ts --strict",
    "verify": "node src/verify.ts --trials 2000",
    "matrix": "node src/matrix.ts --out routes/matrix.json",
    "matrix:summary": "node src/matrix.ts --summary routes/matrix-summary.json",
    "matrix:check": "node src/matrix.ts --check routes/matrix-summary.json",
    "golden": "node src/matrix.ts --golden routes/golden.json",
    "route": "node src/matrix.ts --where",
    "test:unit": "node --test src/logic.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit && npm run verify && npm run explore"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
