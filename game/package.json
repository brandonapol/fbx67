{
  "name": "second-rush-game",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "node --test --test-reporter=dot src/*.test.ts",
    "smoke": "node --test --test-reporter=spec smoke/*.test.ts"
  },
  "dependencies": {
    "playcanvas": "^2.23.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.63.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
